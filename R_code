}

haversine_dist <- function(lon1, lat1, lon2, lat2) {
  R <- 6371
  to_rad <- pi / 180
  dlon <- (lon2 - lon1) * to_rad
  dlat <- (lat2 - lat1) * to_rad
  a <- sin(dlat / 2)^2 + cos(lat1 * to_rad) * cos(lat2 * to_rad) * sin(dlon / 2)^2
  2 * R * asin(pmin(1, sqrt(a)))
}

build_knn_weights <- function(centroids, k) {
  n <- nrow(centroids)
  W <- matrix(0, n, n)
  for (i in seq_len(n)) {
    d <- haversine_dist(centroids$centroid_long[i], centroids$centroid_lat[i],
                         centroids$centroid_long, centroids$centroid_lat)
    d[i] <- Inf
    nearest <- order(d)[seq_len(min(k, n - 1))]
    W[i, nearest] <- 1
  }
  W
}

morans_i_stat <- function(x, W) {
  n <- length(x)
  x_dev <- x - mean(x)
  num <- sum(W * outer(x_dev, x_dev))
  denom <- sum(x_dev^2)
  (n / sum(W)) * (num / denom)
}

morans_i_permutation_test <- function(x, W, n_perm = 10000) {
  observed <- morans_i_stat(x, W)
  perm_values <- numeric(n_perm)
  for (p in seq_len(n_perm)) {
    x_perm <- sample(x)
    perm_values[p] <- morans_i_stat(x_perm, W)
  }
  p_value <- perm_pvalue(perm_values, observed)
  list(observed = observed, p_value = p_value,
       perm_mean = mean(perm_values), perm_sd = sd(perm_values))
}

