# ==============================================================================
# STEP 1 -- CRU + CROPGRIDS -> monthly panel (panelv1)
#
# Loop order: COUNTRY on the outside, CROP on the inside.
#
# Climate data (CRU) does not depend on crop -- a country's temperature and
# precipitation series is the same regardless of which crop is being
# weighted. Only the AREA WEIGHT raster (CROPGRIDS) depends on crop. The
# previous crop-outer loop order re-cropped and re-masked the full 768-layer
# CRU stack once per crop per country (8x redundant work for the same
# country). Looping country-outer instead means each country's CRU stack is
# cropped and masked ONCE, then reused for all 8 crops -- only the cheap
# CROPGRIDS resample step is repeated per crop.
#
# For each country:
#   1. Clip to GADM boundary, crop+mask the CRU stack ONCE
#   2. For each crop: resample that crop's CROPGRIDS weight raster,
#      compute the weighted mean of each CRU variable across the country
#   3. Append the resulting row to that crop's panel
# After all countries: write each crop's panel to panelv1_<crop>.xlsx
# ==============================================================================

# -- CROPGRIDS file/variable helpers --------------------------------------------
# VERIFY the file naming pattern and the harvested-area variable name against
# the actual downloaded CROPGRIDS files -- adjust cropgrids_file() and the
# candidate variable names in load_cropgrids_harvarea() if they don't match.

cropgrids_file <- function(cropgrids_key) {
  # Official naming for the downloaded version: CROPGRIDSv1.08_[CROP].nc
  primary <- file.path(cropgrids_dir, paste0("CROPGRIDSv1.08_", cropgrids_key, ".nc"))
  if (file.exists(primary)) return(primary)
  
  # Fallback: scan the directory for any CROPGRIDS file matching this crop
  # name, in case a different dataset version (e.g. v1.08) was downloaded
  candidates <- list.files(
    cropgrids_dir,
    pattern = paste0("^CROPGRIDSv.*_", cropgrids_key, "\\.nc$"),
    full.names = TRUE, ignore.case = TRUE)
  if (length(candidates) >= 1) return(candidates[1])
  
  primary   # return the expected path anyway so the [!] message is informative
}

# Loads the harvested-area layer from a CROPGRIDS NetCDF file. CROPGRIDS
# NetCDFs typically contain multiple variables (e.g. harvested area,
# irrigated/rainfed splits); this picks the harvested-area one by name
# matching, and reports the variables actually found if none match so the
# candidate list can be corrected.
#
# CRITICAL: CROPGRIDS encodes non-harvested-area pixels with NEGATIVE
# sentinel codes -- -1 = "not assessed", -2 = "ocean/water" -- rather than
# NA. Left as literal negative numbers, these act as negative weights in
# every downstream weighted-average calculation, which can silently flip
# the sign or blow up the scale of TMX_ann/PRE_ann for any country whose
# boundary includes such pixels (coastal countries especially). They are
# converted to NA here, once, so nothing downstream ever sees them.
load_cropgrids_harvarea <- function(nc_path) {
  candidates <- c("harvarea", "harvested_area", "harv_area", "area",
                  "cropland_area", "hectares")
  sds <- tryCatch(terra::sds(nc_path), error = function(e) NULL)
  r <- if (is.null(sds)) {
    tryCatch(terra::rast(nc_path), error = function(e) NULL)
  } else {
    var_names <- names(sds)
    match_idx  <- which(tolower(var_names) %in% candidates)
    if (length(match_idx) == 0) {
      cat("  [WARNING] No harvested-area variable match in", basename(nc_path),
          "-- available variables:", paste(var_names, collapse = ", "), "\n")
      match_idx <- 1   # fallback: first variable, flagged above for manual check
    }
    sds[[match_idx[1]]]
  }
  if (!is.null(r)) r[r < 0] <- NA   # strip -1 "not assessed" / -2 "ocean" flags
  r
}

