verify_actual_draw_counts <- function(country_detail, dataset_tag, world_map) {
  mismatches <- data.frame()
  for (crop in unique(country_detail$crop)) {
    cd <- country_detail[country_detail$crop == crop, ]
    n_undefined_CR <- sum(!is.finite(cd$CR))
    cd <- cd[is.finite(cd$CR), ]
    cd$map_name <- iso3_to_map_name(cd$country)
    n_expected <- length(unique(cd$country))

    merged <- merge(world_map, cd[, c("map_name", "CR", "p_value")],
                     by.x = "region", by.y = "map_name", all.x = TRUE)
    drawn_regions <- unique(merged$region[!is.na(merged$CR)])
    n_drawn <- length(intersect(unique(cd$map_name), drawn_regions))

    if (n_drawn != n_expected) {
      mismatches <- rbind(mismatches, data.frame(
        dataset = dataset_tag, crop = crop,
        n_expected = n_expected, n_actually_drawn = n_drawn,
        n_undefined_CR_excluded = n_undefined_CR
      ))
    }
  }
  mismatches
}

