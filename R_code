make_hatch_lines <- function(poly_df, spacing = 0.6) {
  bbox <- c(min(poly_df$long), max(poly_df$long), min(poly_df$lat), max(poly_df$lat))
  off_min <- bbox[1] - bbox[4]
  off_max <- bbox[2] - bbox[3]
  offsets <- seq(off_min, off_max, by = spacing)
  segs <- data.frame()
  for (off in offsets) {
    xs <- seq(bbox[1], bbox[2], length.out = 100)
    ys <- xs - off
    inside <- rep(FALSE, length(xs))
    for (g in unique(poly_df$group)) {
      sub <- poly_df[poly_df$group == g, ]
      if (nrow(sub) < 3) next
      inside <- inside | as.logical(sp::point.in.polygon(xs, ys, sub$long, sub$lat))
    }
    if (!any(inside)) next
    rl <- rle(inside)
    idx_end <- cumsum(rl$lengths); idx_start <- idx_end - rl$lengths + 1
    for (k in seq_along(rl$lengths)) {
      if (rl$values[k]) {
        i1 <- idx_start[k]; i2 <- idx_end[k]
        segs <- rbind(segs, data.frame(x = xs[i1], xend = xs[i2], y = ys[i1], yend = ys[i2]))
      }
    }
  }
  segs
}

make_spatial_map <- function(crop_name, dataset_tag, country_detail) {
  crop_data <- country_detail[country_detail$crop == crop_name, ]
  crop_data$map_name <- iso3_to_map_name(crop_data$country)

  # CR=NA (null_mean=0, full-sample'da var ama oran tanimsiz) olan ulkeler --
  # bunlar cizim uzerinde capraz cizgiyle (hatching) "veri yok" gri renginden ayirt edilir
  undefined_names <- crop_data$map_name[is.na(crop_data$CR)]

  world_map <- map_data("world")
  world_map <- world_map[world_map$region != "Antarctica", ]

  merged <- merge(world_map, crop_data[, c("map_name", "CR", "p_value")],
                   by.x = "region", by.y = "map_name", all.x = TRUE)
  merged <- merged[order(merged$group, merged$order), ]

  plot_dir_labeled <- file.path(base_dir, "record_montecarlo", "plots", dataset_tag, "labeled")
  plot_dir_unlabeled <- file.path(base_dir, "record_montecarlo", "plots", dataset_tag, "unlabeled")
  dir.create(plot_dir_labeled, showWarnings = FALSE, recursive = TRUE)
  dir.create(plot_dir_unlabeled, showWarnings = FALSE, recursive = TRUE)

  add_hatching <- function(p) {
    for (nm in undefined_names) {
      poly <- world_map[world_map$region == nm, ]
      if (nrow(poly) == 0) next
      hatch <- make_hatch_lines(poly, spacing = 0.6)
      if (nrow(hatch) > 0) {
        p <- p + geom_segment(data = hatch, aes(x = x, xend = xend, y = y, yend = yend),
                               color = "gray40", linewidth = 0.25, inherit.aes = FALSE)
      }
    }
    p
  }

  # Gomulu lejant: "Not in full-sample" (gri kutu) + "CR undefined" (capraz-cizgili kutu)
  # dogrudan gorselin icine ciziliyor -- sembol aciklamasi captionda degil, artworkda olmali
  LEGEND_X0 <- -170; LEGEND_X1 <- -145
  LEGEND_Y_GRAY <- -50; LEGEND_Y_HATCH <- -62
  SWATCH_H <- 7
  hatch_swatch_poly <- data.frame(
    long = c(LEGEND_X0, LEGEND_X1, LEGEND_X1, LEGEND_X0),
    lat  = c(LEGEND_Y_HATCH, LEGEND_Y_HATCH, LEGEND_Y_HATCH + SWATCH_H, LEGEND_Y_HATCH + SWATCH_H),
    group = 1
  )
  hatch_lines_legend <- make_hatch_lines(hatch_swatch_poly, spacing = 1.8)

  add_legend_box <- function(p) {
    p +
      annotate("rect", xmin = LEGEND_X0, xmax = LEGEND_X1, ymin = LEGEND_Y_GRAY, ymax = LEGEND_Y_GRAY + SWATCH_H,
                fill = "gray90", color = "gray40", linewidth = 0.2) +
      annotate("rect", xmin = LEGEND_X0, xmax = LEGEND_X1, ymin = LEGEND_Y_HATCH, ymax = LEGEND_Y_HATCH + SWATCH_H,
                fill = "gray90", color = "gray40", linewidth = 0.2) +
      geom_segment(data = hatch_lines_legend, aes(x = x, xend = xend, y = y, yend = yend),
                   color = "gray40", linewidth = 0.25, inherit.aes = FALSE) +
      annotate("text", x = LEGEND_X1 + 3, y = LEGEND_Y_GRAY + SWATCH_H / 2, label = "Not in full-sample", hjust = 0, size = 2.6) +
      annotate("text", x = LEGEND_X1 + 3, y = LEGEND_Y_HATCH + SWATCH_H / 2, label = "CR undefined", hjust = 0, size = 2.6)
  }

  p_labeled <- ggplot(merged, aes(x = long, y = lat, group = group, fill = CR)) +
    geom_polygon(color = "gray60", linewidth = 0.1) +
    scale_fill_gradient2(low = "#2166AC", mid = "white", high = "#B2182B",
                          midpoint = 1, na.value = "gray90")
  p_labeled <- add_hatching(p_labeled)
  p_labeled <- add_legend_box(p_labeled) +
    coord_fixed(1.3) +
    labs(
      title = sprintf("Country-level concurrence ratio map: %s (%s)", crop_name, dataset_tag),
      fill = "CR"
    ) +
    theme_minimal(base_size = 12) +
    theme(axis.title = element_blank(), axis.text = element_blank(), panel.grid = element_blank())

  p_unlabeled <- ggplot(merged, aes(x = long, y = lat, group = group, fill = CR)) +
    geom_polygon(color = "gray60", linewidth = 0.1) +
    scale_fill_gradient2(low = "#2166AC", mid = "white", high = "#B2182B",
                          midpoint = 1, na.value = "gray90")
  p_unlabeled <- add_hatching(p_unlabeled)
  p_unlabeled <- add_legend_box(p_unlabeled) +
    coord_fixed(1.3) +
    labs(fill = "CR") +
    theme_minimal(base_size = 12) +
    theme(axis.title = element_blank(), axis.text = element_blank(), panel.grid = element_blank())

  fname <- sprintf("spatial_map_%s.pdf", crop_name)
  fname_png <- sprintf("spatial_map_%s.png", crop_name)
  save_pdf(p_labeled, file.path(plot_dir_labeled, fname), width = 10, height = 6)
  save_pdf(p_unlabeled, file.path(plot_dir_unlabeled, fname), width = 10, height = 6)
  save_png(p_labeled, file.path(plot_dir_labeled, fname_png), width = 10, height = 6)
  save_png(p_unlabeled, file.path(plot_dir_unlabeled, fname_png), width = 10, height = 6)
}

