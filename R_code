  gadm_cache <- file.path(base_dir, "gadm",
                          paste0("gadm_41_", iso, "_0_pk.rds"))
  if (file.exists(gadm_cache)) {
    boundary <- readRDS(gadm_cache)
    cat(" [cache]")
  } else {
    boundary <- tryCatch(
      geodata::gadm(country = iso, level = 0, path = base_dir),
      error = function(e) { cat(" [GADM error]"); NULL })
  }
  if (is.null(boundary)) next
  
  # Crop + mask the full CRU stack ONCE for this country -- reused by all 8 crops
  cru_country <- list()
  for (v in names(cru_list)) {
    cru_country[[v]] <- terra::mask(
      terra::crop(cru_list[[v]], terra::ext(boundary)), boundary)
  }
  
  # For each crop: resample that crop's CROPGRIDS weight and compute the
  # weighted mean of each CRU variable using the already-cropped CRU stack
  for (crop_name in names(crop_config)) {
    cg_global <- cropgrids_rast[[crop_name]]
    cg_crop   <- terra::crop(cg_global, terra::ext(boundary))
    
    country_tbl <- data.frame(Country_ISO = iso,
                              Yil = year_month_df$Yil, Ay = year_month_df$Ay)
    
    ref_r    <- cru_country[[1]][[1]]
    cg_res   <- terra::resample(cg_crop, ref_r, method = "sum")
    cg_m     <- terra::mask(cg_res, boundary)
    w_base   <- as.vector(terra::values(cg_m))
    has_area <- !is.na(sum(w_base, na.rm = TRUE)) &&
      sum(w_base, na.rm = TRUE) > 0
    
    for (v in names(cru_country)) {
      v_mat <- terra::values(cru_country[[v]])   # matrix: pixels x 768 months
      
      if (has_area) {
        # Re-resample CROPGRIDS weight to this variable's resolution
        cg_res2 <- terra::resample(cg_crop, cru_country[[v]][[1]], method = "sum")
        w  <- as.vector(terra::values(terra::mask(cg_res2, boundary)))
        ws <- sum(w, na.rm = TRUE)
        monthly <- if (!is.na(ws) && ws > 0)
          colSums(v_mat * w, na.rm = TRUE) / ws   # weighted mean
        else
          colMeans(v_mat, na.rm = TRUE)            # fallback: simple mean
      } else {
        monthly <- colMeans(v_mat, na.rm = TRUE)
      }
      
      if (cru_var_info[[v]]$scale) monthly <- check_scale(monthly, v)
      country_tbl[[toupper(v)]] <- monthly
    }
    
    panel_list[[crop_name]][[iso]] <- country_tbl
  }
  
  cat("  [", round(difftime(Sys.time(), t0, units = "secs"), 1), "s]")
}

