count_records <- function(x, type = c("upper", "lower")) {
  type <- match.arg(type)
  n <- length(x); rec <- integer(n); rec[1] <- 1L; running <- x[1]
  if (type == "upper") { for (t in 2:n) if (x[t] > running) { rec[t] <- 1L; running <- x[t] } }
  else { for (t in 2:n) if (x[t] < running) { rec[t] <- 1L; running <- x[t] } }
  rec
}
perm_pvalue <- function(null_dist, observed) (1 + sum(null_dist >= observed)) / (1 + length(null_dist))

block_resample_series <- function(x, block_len = BLOCK_LEN) {
  n <- length(x)
  n_blocks <- ceiling(n / block_len)
  max_start <- n - block_len + 1
  starts <- sample(seq_len(max_start), n_blocks, replace = TRUE)
  out <- unlist(lapply(starts, function(s) x[s:(s + block_len - 1)]))
  out[seq_len(n)]
}

run_block_resampling_crop <- function(crop) {
  raw <- as.data.frame(read_excel(sprintf("panelv7_%s.xlsx", crop)))
  raw <- raw[, c("Country_ISO", "Yil", "yield_hg_per_ha", "TMX_ann")]
  raw <- raw[order(raw$Country_ISO, raw$Yil), ]

  full_years <- YEAR_START:YEAR_END
  keep <- c()
  for (ctry in unique(raw$Country_ISO)) {
    sub <- raw[raw$Country_ISO == ctry, ]
    if (nrow(sub) < 64) next
    if (any(is.na(sub$yield_hg_per_ha)) || any(is.na(sub$TMX_ann))) next
    if (!all(full_years %in% sub$Yil)) next
    keep <- c(keep, ctry)
  }
  df <- raw[raw$Country_ISO %in% keep, ]
  cat(sprintf("  %s: full-sample ulke sayisi = %d\n", crop, length(keep)))

  yield_rec_list <- list()
  temp_list <- list()
  observed_total <- 0

  for (ctry in unique(df$Country_ISO)) {
    sub <- df[df$Country_ISO == ctry, ]
    yield_raw <- sub$yield_hg_per_ha
    temp_raw <- sub$TMX_ann
    t_index <- seq_along(yield_raw)
    yield_detrend <- residuals(lm(yield_raw ~ t_index))

    rec_temp <- count_records(temp_raw, "upper"); rec_temp[1] <- 0L
    rec_yield <- count_records(yield_detrend, "lower"); rec_yield[1] <- 0L

    observed_total <- observed_total + sum(rec_temp * rec_yield)
    yield_rec_list[[ctry]] <- rec_yield
    temp_list[[ctry]] <- temp_raw
  }

  # Havuzlanmis Monte Carlo null: her replikasyonda HER ulke icin
  # BAGIMSIZ bir blok-yeniden-orneklemesi cekilir (Null A'nin
  # ulkeye-ozel bagimsizlik mantigiyla tutarli), toplam eszamanlilik
  # sayisi ulkeler arasinda toplanir.
  pooled_null <- integer(B_pooled)
  ctry_names <- names(temp_list)
  for (b in seq_len(B_pooled)) {
    tot <- 0
    for (ctry in ctry_names) {
      temp_resampled <- block_resample_series(temp_list[[ctry]])
      rec_temp_r <- count_records(temp_resampled, "upper"); rec_temp_r[1] <- 0L
      tot <- tot + sum(rec_temp_r * yield_rec_list[[ctry]])
    }
    pooled_null[b] <- tot
  }

  p_value <- perm_pvalue(pooled_null, observed_total)
  CR <- observed_total / mean(pooled_null)

  data.frame(crop = crop, n_countries = length(keep), method = "block_resampling",
             observed_total = observed_total, null_mean = mean(pooled_null),
             CR = CR, p_value = p_value)
}

