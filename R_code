simulate_one_world_param <- function(n_countries, Tn, cf_sd, ar_temp, ar_yield, trend_on, heterosked_on) {
  common_factor <- if (cf_sd > 0) cumsum(rnorm(Tn, sd = cf_sd / sqrt(Tn))) else rep(0, Tn)
  temp_list <- list(); yield_list <- list()
  for (i in seq_len(n_countries)) {
    trend_i <- if (trend_on) rnorm(1, temp_trend_slope_mean, temp_trend_slope_sd) else 0
    loading_i <- runif(1, 0.5, 1.5)
    ar1 <- numeric(Tn); ar1[1] <- rnorm(1)
    for (t in 2:Tn) ar1[t] <- ar_temp * ar1[t - 1] + rnorm(1, sd = sqrt(1 - ar_temp^2))
    temp_list[[i]] <- trend_i * seq_len(Tn) + loading_i * common_factor + ar1

    ytrend_i <- if (trend_on) rnorm(1, yield_trend_slope_mean, yield_trend_slope_sd) else 0
    ar1y <- numeric(Tn); ar1y[1] <- rnorm(1)
    for (t in 2:Tn) ar1y[t] <- ar_yield * ar1y[t - 1] + rnorm(1, sd = sqrt(1 - ar_yield^2))
    hetero_sd <- if (heterosked_on) 1 + heterosked_slope * seq_len(Tn) else rep(1, Tn)
    yield_list[[i]] <- 100 + ytrend_i * seq_len(Tn) + ar1y * hetero_sd
  }
  list(temp = temp_list, yield = yield_list)
}

