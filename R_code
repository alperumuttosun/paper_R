detrend_yield <- function(yield_raw, method = c("linear", "quadratic", "loess")) {
  method <- match.arg(method)
  t_index <- seq_along(yield_raw)
  if (method == "linear") {
    residuals(lm(yield_raw ~ t_index))
  } else if (method == "quadratic") {
    residuals(lm(yield_raw ~ t_index + I(t_index^2)))
  } else {
    fit <- loess(yield_raw ~ t_index, span = 0.75)
    yield_raw - predict(fit)
  }
}

run_crop_detrend_variant <- function(df, crop, B_pooled, detrend_method) {
  obs_list <- numeric(0)
  null_list <- list()

  for (ctry in unique(df$Country_ISO)) {
    sub <- df[df$Country_ISO == ctry, ]
    yield_raw <- sub$yield_hg_per_ha
    temp_raw <- sub$TMX_ann
    n_years <- length(yield_raw)
    if (n_years < 10) next

    yield_detrend <- detrend_yield(yield_raw, detrend_method)

    rec_temp <- count_records(temp_raw, "upper")
    rec_yield_detrend <- count_records(yield_detrend, "lower")
    rec_temp_conc <- rec_temp; rec_temp_conc[1] <- 0L
    rec_yield_conc <- rec_yield_detrend; rec_yield_conc[1] <- 0L
    obs_detrend <- sum(rec_temp_conc * rec_yield_conc)

    nulldist <- circular_shift_null(temp_raw, yield_detrend, n_shift = n_years - 1)

    obs_list <- c(obs_list, obs_detrend)
    null_list[[ctry]] <- nulldist
  }

  observed_total <- sum(obs_list)
  pooled_null <- numeric(B_pooled)
  for (b in seq_len(B_pooled)) {
    total_b <- 0
    for (ctry in names(null_list)) total_b <- total_b + sample(null_list[[ctry]], 1)
    pooled_null[b] <- total_b
  }

  data.frame(
    crop = crop, detrend_method = detrend_method,
    observed_total = observed_total,
    pooled_null_mean = mean(pooled_null),
    CR = observed_total / mean(pooled_null),
    p_value = perm_pvalue(pooled_null, observed_total)
  )
}

run_crop_synchronized_detrend_variant <- function(df, crop, detrend_method) {
  countries <- unique(df$Country_ISO)
  temp_list <- list()
  yield_rec_list <- list()
  n_years_ref <- NULL
  observed_total <- 0

  for (ctry in countries) {
    sub <- df[df$Country_ISO == ctry, ]
    yield_raw <- sub$yield_hg_per_ha
    temp_raw <- sub$TMX_ann
    ny <- length(yield_raw)
    if (ny < 10) next
    if (is.null(n_years_ref)) n_years_ref <- ny
    if (ny != n_years_ref) next

    yield_detrend <- detrend_yield(yield_raw, detrend_method)
    rec_temp <- count_records(temp_raw, "upper"); rec_temp[1] <- 0L
    rec_yield <- count_records(yield_detrend, "lower"); rec_yield[1] <- 0L

    observed_total <- observed_total + sum(rec_temp * rec_yield)
    temp_list[[ctry]] <- temp_raw
    yield_rec_list[[ctry]] <- rec_yield
  }

  n <- n_years_ref
  n_shift <- n - 1
  sync_null <- numeric(n_shift)
  for (i in seq_len(n_shift)) {
    total_i <- 0
    for (ctry in names(temp_list)) {
      temp_shift <- temp_list[[ctry]][((seq_len(n) - 1 + i) %% n) + 1]
      rec_temp_shift <- count_records(temp_shift, "upper")
      rec_temp_shift[1] <- 0L
      total_i <- total_i + sum(rec_temp_shift * yield_rec_list[[ctry]])
    }
    sync_null[i] <- total_i
  }

  data.frame(
    crop = crop, detrend_method = detrend_method,
    observed_total = observed_total,
    sync_null_mean = mean(sync_null),
    sync_CR = observed_total / mean(sync_null),
    sync_p = perm_pvalue(sync_null, observed_total)
  )
}

