perm_pvalue <- function(null_dist, observed) {
  (1 + sum(null_dist >= observed)) / (1 + length(null_dist))
}

count_records <- function(x, type = c("upper", "lower")) {
  type <- match.arg(type)
  n <- length(x)
  rec <- integer(n)
  rec[1] <- 1L
  running <- x[1]
  if (type == "upper") {
    for (t in 2:n) if (x[t] > running) { rec[t] <- 1L; running <- x[t] }
  } else {
    for (t in 2:n) if (x[t] < running) { rec[t] <- 1L; running <- x[t] }
  }
  rec
}

circular_shift_null <- function(temp_series, yield_series, n_shift) {
  n <- length(temp_series)
  rec_yield <- count_records(yield_series, "lower")
  rec_yield[1] <- 0L
  null_counts <- integer(n_shift)
  for (i in seq_len(n_shift)) {
    temp_shift <- temp_series[((seq_len(n) - 1 + i) %% n) + 1]
    rec_temp_shift <- count_records(temp_shift, "upper")
    rec_temp_shift[1] <- 0L
    null_counts[i] <- sum(rec_temp_shift * rec_yield)
  }
  null_counts
}

block_shift_null <- function(temp_series, yield_series, block_length, n_reps) {
  n <- length(temp_series)
  rec_yield <- count_records(yield_series, "lower")
  rec_yield[1] <- 0L
  n_blocks <- ceiling(n / block_length)
  null_counts <- integer(n_reps)
  for (r in seq_len(n_reps)) {
    starts <- sample(seq_len(n), n_blocks, replace = TRUE)
    idx <- unlist(lapply(starts, function(s) ((s - 1 + 0:(block_length - 1)) %% n) + 1))
    idx <- idx[seq_len(n)]
    temp_shuffled <- temp_series[idx]
    rec_temp_shuffled <- count_records(temp_shuffled, "upper")
    rec_temp_shuffled[1] <- 0L
    null_counts[r] <- sum(rec_temp_shuffled * rec_yield)
  }
  null_counts
}

read_raw_crop <- function(crop, base_dir) {
  path <- file.path(base_dir, sprintf("panelv7_%s.xlsx", crop))
  raw <- as.data.frame(read_excel(path))
  raw <- raw[, c("Country_ISO", "Yil", "yield_hg_per_ha", "TMX_ann")]
  raw[order(raw$Country_ISO, raw$Yil), ]
}

filter_crop_data <- function(raw, min_years, year_start, year_end) {
  full_years <- year_start:year_end
  country_list <- unique(raw$Country_ISO)
  keep_countries <- character(0)

  for (ctry in country_list) {
    sub <- raw[raw$Country_ISO == ctry, ]
    if (nrow(sub) < min_years) next
    if (any(is.na(sub$yield_hg_per_ha)) || any(is.na(sub$TMX_ann))) next
    if (min_years >= length(full_years)) {
      if (!all(full_years %in% sub$Yil)) next
    }
    keep_countries <- c(keep_countries, ctry)
  }

  raw[raw$Country_ISO %in% keep_countries, ]
}

run_crop <- function(df, crop, B_pooled) {
  obs_list <- numeric(0)
  null_list <- list()
  country_rows <- data.frame()

  for (ctry in unique(df$Country_ISO)) {
    sub <- df[df$Country_ISO == ctry, ]
    yield_raw <- sub$yield_hg_per_ha
    temp_raw <- sub$TMX_ann
    n_years <- length(yield_raw)
    if (n_years < 10) next
    t_index <- seq_along(yield_raw)

    yield_detrend <- residuals(lm(yield_raw ~ t_index))

    rec_temp <- count_records(temp_raw, "upper")
    rec_yield_raw <- count_records(yield_raw, "lower")
    rec_yield_detrend <- count_records(yield_detrend, "lower")

    rec_temp_conc <- rec_temp; rec_temp_conc[1] <- 0L
    rec_yield_raw_conc <- rec_yield_raw; rec_yield_raw_conc[1] <- 0L
    rec_yield_detrend_conc <- rec_yield_detrend; rec_yield_detrend_conc[1] <- 0L

    obs_raw <- sum(rec_temp_conc * rec_yield_raw_conc)
    obs_detrend <- sum(rec_temp_conc * rec_yield_detrend_conc)

    nulldist <- circular_shift_null(temp_raw, yield_detrend, n_shift = n_years - 1)

    obs_list <- c(obs_list, obs_detrend)
    null_list[[ctry]] <- nulldist

    null_mean_val <- mean(nulldist)
    CR_val <- if (null_mean_val > 0) obs_detrend / null_mean_val else NA_real_

    country_rows <- rbind(country_rows, data.frame(
      crop = crop,
      country = ctry,
      n_years = n_years,
      yield_records_raw = sum(rec_yield_raw),
      yield_records_detrend = sum(rec_yield_detrend),
      temp_records = sum(rec_temp),
      concurrence_raw = obs_raw,
      concurrence_detrend = obs_detrend,
      null_mean = null_mean_val,
      CR = CR_val,
      p_value = perm_pvalue(nulldist, obs_detrend)
    ))
  }

  country_rows$p_FDR <- p.adjust(country_rows$p_value, method = "BH")

  observed_total <- sum(obs_list)
  pooled_null <- numeric(B_pooled)
  for (b in seq_len(B_pooled)) {
    total_b <- 0
    for (ctry in names(null_list)) total_b <- total_b + sample(null_list[[ctry]], 1)
    pooled_null[b] <- total_b
  }

  crop_summary <- data.frame(
    crop = crop,
    n_countries = length(obs_list),
    observed_total = observed_total,
    pooled_null_mean = mean(pooled_null),
    pooled_null_p2.5 = quantile(pooled_null, 0.025),
    pooled_null_p97.5 = quantile(pooled_null, 0.975),
    global_CR = observed_total / mean(pooled_null),
    global_p = perm_pvalue(pooled_null, observed_total),
    n_significant_FDR = sum(country_rows$p_FDR < 0.05)
  )

  list(summary = crop_summary, country = country_rows, pooled_null = pooled_null)
}

run_all_crops <- function(min_years, raw_data_list, B_pooled) {
  all_summary <- data.frame()
  all_country <- data.frame()
  pooled_null_store <- list()

  for (crop in crops) {
    df <- filter_crop_data(raw_data_list[[crop]], min_years, YEAR_START, YEAR_END)
    res <- run_crop(df, crop, B_pooled)
    all_summary <- rbind(all_summary, res$summary)
    all_country <- rbind(all_country, res$country)
    pooled_null_store[[crop]] <- res$pooled_null
  }

  list(summary = all_summary, country = all_country, pooled_null = pooled_null_store)
}

run_crop_block_shift <- function(df, crop, B_pooled, block_length, n_reps) {
  obs_list <- numeric(0)
  null_list <- list()

  for (ctry in unique(df$Country_ISO)) {
    sub <- df[df$Country_ISO == ctry, ]
    yield_raw <- sub$yield_hg_per_ha
    temp_raw <- sub$TMX_ann
    n_years <- length(yield_raw)
    if (n_years < 10) next
    t_index <- seq_along(yield_raw)

    yield_detrend <- residuals(lm(yield_raw ~ t_index))

    rec_temp <- count_records(temp_raw, "upper")
    rec_yield_detrend <- count_records(yield_detrend, "lower")
    rec_temp_conc <- rec_temp; rec_temp_conc[1] <- 0L
    rec_yield_detrend_conc <- rec_yield_detrend; rec_yield_detrend_conc[1] <- 0L
    obs_detrend <- sum(rec_temp_conc * rec_yield_detrend_conc)

    nulldist <- block_shift_null(temp_raw, yield_detrend, block_length, n_reps)

    obs_list <- c(obs_list, obs_detrend)
    null_list[[ctry]] <- nulldist
  }

  observed_total <- sum(obs_list)
  pooled_null <- numeric(B_pooled)
  for (b in seq_len(B_pooled)) {
    total_b <- 0
    for (ctry in names(null_list)) total_b <- total_b + sample(null_list[[ctry]], 1)
    pooled_null[b] <- total_b
  }

  data.frame(
    crop = crop,
    observed_total = observed_total,
    pooled_null_mean = mean(pooled_null),
    global_CR = observed_total / mean(pooled_null),
    global_p = perm_pvalue(pooled_null, observed_total)
  )
}

run_block_shift_robustness <- function(raw_data_list, B_pooled, block_length = 8, n_reps = 63) {
  block_summary <- data.frame()
  for (crop in crops) {
    df <- filter_crop_data(raw_data_list[[crop]], 64, YEAR_START, YEAR_END)
    block_summary <- rbind(block_summary, run_crop_block_shift(df, crop, B_pooled, block_length, n_reps))
  }
  block_summary
}

