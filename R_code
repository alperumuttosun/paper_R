sim_iid <- function(n) rnorm(n)

sim_ar1 <- function(n, rho) {
  x <- numeric(n)
  x[1] <- rnorm(1)
  for (t in 2:n) x[t] <- rho * x[t - 1] + rnorm(1) * sqrt(1 - rho^2)
  x
}

sim_trend <- function(n, slope = 0.03) slope * (1:n) + rnorm(n)

sim_trend_ar1 <- function(n, rho, slope = 0.03) slope * (1:n) + sim_ar1(n, rho)

sim_heterosk <- function(n) {
  sigma_t <- seq(0.5, 2, length.out = n)
  rnorm(n, sd = sigma_t)
}

sim_trend_ar1_hetero <- function(n, rho, slope = 0.03) {
  sigma_t <- seq(0.5, 1.5, length.out = n)
  slope * (1:n) + sim_ar1(n, rho) * sigma_t
}

