  panelv1_countries[[crop_name]] <- sort(unique(monthly_df$Country_ISO))
  cat("[OK]", nrow(monthly_df), "rows |",
      length(unique(monthly_df$Country_ISO)), "countries\n")
  
  fao_crop_sub <- fao_wide[fao_wide$Item %in% cfg$fao, ]
  annual_df <- tryCatch(
    annual_aggregate(crop_name, monthly_df, fao_crop_sub),
    error = function(e) { cat("[ERROR]", conditionMessage(e), "\n"); NULL })
  if (is.null(annual_df)) next
  
  # Apply yield/year filters
  n0 <- nrow(annual_df)
  annual_df <- annual_df[!is.na(annual_df$production_tonnes), ]
  n1 <- nrow(annual_df)
  cat("  Remove FAO NA:", n0 - n1, "| remaining:", n1, "\n")
  
  annual_df <- annual_df[!is.na(annual_df$yield_hg_per_ha) &
                           annual_df$yield_hg_per_ha >= YIELD_THRESHOLD, ]
  n2 <- nrow(annual_df)
  cat("  Remove yield <", YIELD_THRESHOLD, ":", n1 - n2, "| remaining:", n2, "\n")
  
  year_counts <- annual_df %>%
    dplyr::group_by(Country_ISO) %>%
    dplyr::summarise(n = dplyr::n(), .groups = "drop")
  annual_df <- annual_df[annual_df$Country_ISO %in%
                           year_counts$Country_ISO[year_counts$n >= MIN_YEARS], ]
  n3 <- nrow(annual_df)
  cat("  Remove <", MIN_YEARS, "years:", n2 - n3,
      "| remaining:", n3, "rows |", length(unique(annual_df$Country_ISO)), "countries\n")
  
  writexl::write_xlsx(annual_df, output_path)
  cat("  [SAVED]", basename(output_path), "\n")
  rm(monthly_df, annual_df, fao_crop_sub); gc()
}


