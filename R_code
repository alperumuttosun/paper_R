    geom_col(color = "black", linewidth = 0.3) +
    geom_hline(yintercept = 1, linetype = "dashed", color = "gray30") +
    geom_text(aes(label = sprintf("p=%.3f", global_p)), vjust = -0.5, size = 3) +
    scale_fill_manual(values = crop_colors) +
