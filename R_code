##################################################
# TYPE-I HATA (SIZE) SIMULASYONU
#
# Amac: Null A ve Null B'nin GERCEKTEN nominal %5 seviyesinde
# Tip-I hata kontrolu saglayip saglamadigini test etmek.
#
# Yontem: "Dunya" simule ediyoruz - sicaklik ve verim serileri
# arasinda HICBIR gercek concurrence iliskisi YOK (H0 dogru),
# ama gercekci bir bagimlilik yapisi VAR:
#   - Sicaklikta: ulkeye ozel trend + ortak (cross-country) sok
#     faktoru (farkli ulkelerde farkli agirlikla) + AR(1)
#   - Verimde: bagimsiz trend + kendi AR(1)'i + artan varyans
#     (heteroskedastisite) - sicaklikla veya ortak faktorle HICBIR
#     baglantisi yok
# Sonra ayni gercek analiz koduyla (count_records, circular_shift_null,
# perm_pvalue - yukarida zaten tanimli) Null A ve Null B pooled
# testlerini calistirip p-degerini kaydediyoruz. Bunu SIM_N_REPS kez
# tekrarlayip p<0.05 oranina bakiyoruz - eger null dogru kalibre
# ediyorsa bu oran ~0.05 civarinda olmali.
#
# ÖNEMLI: Bu bolum hesaplama acisindan agir olabilir. Asagidaki
# parametreleri (ozellikle SIM_N_REPS ve SIM_B_POOLED) makinenizin
# gucune gore ayarlayin. Kaba tahmin: SIM_N_REPS=500, SIM_B_POOLED=2000,
# SIM_N_COUNTRIES=60 ile calisma suresi muhtemelen 30-90 dakika
# arasinda olabilir (Null A'nin pooled Monte Carlo adimi en pahali
# kisim). Once kucuk bir deneme (SIM_N_REPS=20) ile calisma suresini
# olcup sonra tam calistirmanizi oneririm.
##################################################

SIM_N_COUNTRIES <- 60        # simule edilen ulke sayisi (gercek veriyle kiyaslanabilir buyuklukte)
SIM_T <- 64                  # seri uzunlugu (full-sample ile ayni)
SIM_N_REPS <- 500            # kac "dunya" simule edilecek (arttirmak hassasiyeti arttirir, suredeyi de arttirir)
SIM_B_POOLED <- 2000         # Null A'nin pooled Monte Carlo cekim sayisi (10000 yerine 2000 - hiz icin; isterseniz arttirin)

# --- DGP (veri-uretme-sureci) parametreleri - gercekci degerler, degistirebilirsiniz ---
common_factor_sd      <- 1.0   # ulkeler-arasi ortak sicaklik soku gucu (Null B'nin tam olarak test ettigi yapi)
country_ar1_rho_temp  <- 0.4   # sicaklikta ulkeye-ozel AR(1) katsayisi
country_ar1_rho_yield <- 0.3   # verimde ulkeye-ozel AR(1) katsayisi
temp_trend_slope_mean <- 0.02  # ortalama yillik isinma egilimi (ulkeler arasi degisken)
temp_trend_slope_sd   <- 0.01
yield_trend_slope_mean<- 1.0   # ortalama yillik verim artis egilimi (keyfi birim)
yield_trend_slope_sd  <- 0.3
heterosked_slope      <- 0.02  # verim gurultusunde zamanla artan varyans

simulate_one_world <- function(n_countries = SIM_N_COUNTRIES, Tn = SIM_T) {
  # Ortak faktor: rastgele-yuruyus benzeri, tum ulkeleri farkli agirliklarla etkileyen paylasilan bir sok
  # (kuresel isinma sinyali veya bolgesel iklim anomalisi icin stilize bir vekil)
  common_factor <- cumsum(rnorm(Tn, sd = common_factor_sd / sqrt(Tn)))

  temp_list <- list()
  yield_list <- list()

  for (i in seq_len(n_countries)) {
    # --- Sicaklik: trend + ortak faktore maruziyet + ulkeye-ozel AR(1) + gurultu ---
    trend_i <- rnorm(1, temp_trend_slope_mean, temp_trend_slope_sd)
    loading_i <- runif(1, 0.5, 1.5)
    ar1 <- numeric(Tn)
    ar1[1] <- rnorm(1)
    for (t in 2:Tn) ar1[t] <- country_ar1_rho_temp * ar1[t - 1] + rnorm(1, sd = sqrt(1 - country_ar1_rho_temp^2))
    temp_i <- trend_i * seq_len(Tn) + loading_i * common_factor + ar1
    temp_list[[i]] <- temp_i

    # --- Verim: BAGIMSIZ trend + kendi AR(1)'i + heteroskedastik gurultu ---
    # (sicaklikla veya ortak faktorle HICBIR baglantisi yok - H0 boylece dogru)
    ytrend_i <- rnorm(1, yield_trend_slope_mean, yield_trend_slope_sd)
    ar1y <- numeric(Tn)
    ar1y[1] <- rnorm(1)
    for (t in 2:Tn) ar1y[t] <- country_ar1_rho_yield * ar1y[t - 1] + rnorm(1, sd = sqrt(1 - country_ar1_rho_yield^2))
    hetero_sd <- 1 + heterosked_slope * seq_len(Tn)
    yield_i <- 100 + ytrend_i * seq_len(Tn) + ar1y * hetero_sd
    yield_list[[i]] <- yield_i
  }

  list(temp = temp_list, yield = yield_list)
}

run_nullA_on_world <- function(world, B_pooled = SIM_B_POOLED) {
  n_countries <- length(world$temp)
  obs_list <- numeric(n_countries)
  null_list <- list()
  for (i in seq_len(n_countries)) {
    temp_i <- world$temp[[i]]; yield_i <- world$yield[[i]]
    t_index <- seq_along(yield_i)
    yield_detrend <- residuals(lm(yield_i ~ t_index))
    rec_temp <- count_records(temp_i, "upper"); rec_temp[1] <- 0L
    rec_yield <- count_records(yield_detrend, "lower"); rec_yield[1] <- 0L
    obs_list[i] <- sum(rec_temp * rec_yield)
    null_list[[i]] <- circular_shift_null(temp_i, yield_detrend, n_shift = length(temp_i) - 1)
  }
  observed_total <- sum(obs_list)
  pooled_null <- numeric(B_pooled)
  for (b in seq_len(B_pooled)) {
    tot <- 0
    for (i in seq_len(n_countries)) tot <- tot + sample(null_list[[i]], 1)
    pooled_null[b] <- tot
  }
  perm_pvalue(pooled_null, observed_total)
}

run_nullB_on_world <- function(world) {
  n_countries <- length(world$temp)
  Tn <- length(world$temp[[1]])
  yield_rec_list <- list()
  observed_total <- 0
  for (i in seq_len(n_countries)) {
    temp_i <- world$temp[[i]]; yield_i <- world$yield[[i]]
    t_index <- seq_along(yield_i)
    yield_detrend <- residuals(lm(yield_i ~ t_index))
    rec_temp <- count_records(temp_i, "upper"); rec_temp[1] <- 0L
    rec_yield <- count_records(yield_detrend, "lower"); rec_yield[1] <- 0L
    observed_total <- observed_total + sum(rec_temp * rec_yield)
    yield_rec_list[[i]] <- rec_yield
  }
  n_shift <- Tn - 1
  sync_null <- numeric(n_shift)
  for (k in seq_len(n_shift)) {
    tot <- 0
    for (i in seq_len(n_countries)) {
      temp_shift <- world$temp[[i]][((seq_len(Tn) - 1 + k) %% Tn) + 1]
      rec_temp_shift <- count_records(temp_shift, "upper"); rec_temp_shift[1] <- 0L
      tot <- tot + sum(rec_temp_shift * yield_rec_list[[i]])
    }
    sync_null[k] <- tot
  }
  perm_pvalue(sync_null, observed_total)
}

